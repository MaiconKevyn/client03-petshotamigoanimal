---
import Cabecalho from '../components/Cabecalho.astro';
import Contato from '../components/Contato.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Destaques from '../components/Destaques.astro';
import Agendamento from '../components/Agendamento.astro';
import Hero from '../components/Hero.astro';
import Rodape from '../components/Rodape.astro';
import Servicos from '../components/Servicos.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const title = 'Amigo Animal | Veterinário e pet shop em Porto Alegre';
const description =
  'Pet shop com atendimento veterinário, castração, profilaxia dentária, banho e tosa, rações e medicamentos. Cuidado completo para cães e gatos.';
---

<SiteLayout {title} {description}>
  <Cabecalho />
  <main id="conteudo">
    <Hero />
    <Destaques />
    <Servicos />
    <Depoimentos />
    <Agendamento />
    <Contato />
  </main>
  <Rodape />
</SiteLayout>
