---
import Icone from './Icone.astro';
import { resultadoBanhoTosa } from '../data/banho-tosa';
import { site } from '../data/site';

interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
const agendamento = `${site.whatsapp}?text=${encodeURIComponent(
  'Olá! Vi o antes e depois no site e gostaria de agendar banho e tosa para meu pet. Quais horários estão disponíveis?',
)}`;
---

<article
  class="cartao-destaque cartao-destaque--banho"
  id="antes-depois"
  aria-labelledby="titulo-banho-tosa"
>
  <div class="comparacao__cabecalho">
    <h3 class="cartao-destaque__titulo" id="titulo-banho-tosa">{titulo}</h3>
    <a class="cartao-destaque__acao" href={agendamento} target="_blank" rel="noopener noreferrer" aria-label="Agendar banho e tosa pelo WhatsApp">
      Agendar banho e tosa <Icone nome="setaDiagonal" />
    </a>
  </div>

  <div class="comparacao__fotos" role="group" aria-label="Antes e depois do banho e tosa, com imagens aprimoradas por IA">
    {(['antes', 'depois'] as const).map((etapa) => (
      <figure class="comparacao__foto">
        <img
          src={resultadoBanhoTosa[etapa].fotoCompacta}
          srcset={`${resultadoBanhoTosa[etapa].fotoCompacta} 640w, ${resultadoBanhoTosa[etapa].foto} ${resultadoBanhoTosa[etapa].largura}w`}
          sizes="(max-width: 480px) calc(50vw - 20px), (min-width: 1181px) min(15vw, 220px), 220px"
          alt={resultadoBanhoTosa[etapa].alt}
          width={resultadoBanhoTosa[etapa].largura}
          height={resultadoBanhoTosa[etapa].altura}
          loading="lazy"
          decoding="async"
        />
        <figcaption>{etapa === 'antes' ? 'Antes' : 'Depois'}</figcaption>
      </figure>
    ))}
  </div>
</article>
