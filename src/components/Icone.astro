const desenho = caminhos[nome] ?? caminhos.pata;
const preenchido = ['pata', 'cruz', 'aspas', 'play', 'coracaoPata', 'dente'].includes(nome);
---

<svg
  viewBox="0 0 20 20"
  class={classe}
  aria-hidden="true"
  focusable="false"
  fill={preenchido ? 'currentColor' : 'none'}
  stroke={preenchido ? 'none' : 'currentColor'}
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={desenho}
/>
