---
import Icone from './Icone.astro';
import { servicos, site } from '../data/site';
---

<section class="servicos" id="servicos">
  <div class="container">
    <div class="servicos__marca">
      <p class="fantasma" aria-hidden="true">serviços</p>
      <div class="servicos__etiquetas" aria-hidden="true">
        <span class="etiqueta etiqueta--1">Cuidado veterinário</span>
        <span class="etiqueta etiqueta--2">Castração segura</span>
        <span class="etiqueta etiqueta--3">Banho &amp; tosa</span>
        <span class="etiqueta etiqueta--4">Pet shop</span>
      </div>
    </div>

    <h2 class="servicos__intro">Tudo o que seu pet precisa, com cuidado em cada detalhe</h2>

    <div class="servicos__lista">
      {
        servicos.map((servico) => (
          <article class="servico">
            <span class="servico__icone">
              <Icone nome={servico.icone} />
            </span>
            <div class="servico__conteudo">
              <div class="servico__midia">
                <img
                  class="servico__miniatura"
                  src={servico.miniatura}
                  alt={servico.alt}
                  width="1000"
                  height="700"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="servico__corpo">
                <h3 class="servico__titulo">{servico.titulo}</h3>
                <p class="servico__texto">{servico.texto}</p>
              </div>
            </div>
            <a
              class="botao botao--blush botao--pequeno"
              href={`${site.whatsapp}?text=${encodeURIComponent(servico.mensagemWhatsApp)}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${servico.acao} pelo WhatsApp. Abre em uma nova aba.`}
            >
              {servico.acao}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
