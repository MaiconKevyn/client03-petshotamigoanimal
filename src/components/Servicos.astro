---
import Icone from './Icone.astro';
import { servicos, site } from '../data/site';
---

<section class="servicos" id="servicos">
  <div class="container">
    <div class="servicos__cabecalho">
      <div>
        <h2 class="titulo-secao">Do que seu pet precisa?</h2>
        <p class="olho">Escolha um serviço e fale direto com a equipe.</p>
      </div>
      <div class="servicos__filtros" role="group" aria-label="Filtrar serviços" data-filtros hidden>
        <button type="button" aria-pressed="true" data-filtro="todos">Todos</button>
        <button type="button" aria-pressed="false" data-filtro="veterinario">Veterinário</button>
        <button type="button" aria-pressed="false" data-filtro="petshop">Pet shop</button>
      </div>
    </div>
    <p class="visualmente-oculto" role="status" data-servicos-status></p>

    <div class="servicos__lista">
      {
        servicos.map((servico) => (
          <article class="servico" id={servico.id} data-servico-categoria={servico.categoria}>
            <span class="servico__icone">
              <Icone nome={servico.icone} />
            </span>
            <div class="servico__conteudo">
              <div class="servico__midia">
                <img
                  class="servico__miniatura"
                  src={servico.miniatura}
                  alt={servico.alt}
                  width="1000"
                  height="700"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="servico__corpo">
                <h3 class="servico__titulo">{servico.titulo}</h3>
                <p class="servico__texto">{servico.texto}</p>
              </div>
            </div>
            <a
              class="botao botao--blush botao--pequeno"
              href={`${site.whatsapp}?text=${encodeURIComponent(servico.mensagemWhatsApp)}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${servico.acao} pelo WhatsApp. Abre em uma nova aba.`}
            >
              {servico.acao}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script src="../scripts/servicos.js"></script>
