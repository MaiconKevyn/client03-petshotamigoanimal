---
import Icone from './Icone.astro';
import { depoimentos } from '../data/site';

const grupos = [false, true] as const;
---

<section class="depoimentos" id="depoimentos">
  <div class="container">
    <h2 class="visualmente-oculto">O que dizem nossos clientes</h2>

    <div class="depoimentos__janela" aria-label="Depoimentos de clientes">
      <div class="depoimentos__trilho">
        {
          grupos.map((duplicado) => (
            <div class="depoimentos__grupo" aria-hidden={duplicado ? 'true' : undefined}>
              {depoimentos.map((item) => (
                <article class="depoimento">
                  <h3 class="depoimento__titulo">
                    <Icone nome="aspas" />
                    {item.titulo}
                  </h3>
                  <p class="depoimento__texto">{item.texto}</p>
                  <div class="depoimento__autor">
                    <img src={item.foto} alt="" loading="lazy" decoding="async" />
                    <div>
                      <p class="depoimento__nome">{item.nome}</p>
                      <p class="depoimento__papel">Cliente da clínica</p>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="depoimentos__rodape">
    <p class="fantasma" aria-hidden="true">clientes</p>
    <img
      class="depoimentos__cao"
      src="/assets/img/dalmata.webp"
      alt=""
      width="288"
      height="259"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>
