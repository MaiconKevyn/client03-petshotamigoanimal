---
import Icone from './Icone.astro';
import { agendamentoLink, servicos, site } from '../data/site';

const ano = new Date().getFullYear();
const endereco = `${site.endereco.rua}, ${site.endereco.cidade}/${site.endereco.uf}`;
---

<footer class="rodape">
  <div class="container">
    <div class="rodape__topo">
      <span class="marca">
        <img class="marca__simbolo" src="/assets/img/marca-amigo-animal.webp" alt="" width="56" height="56" />
        <span class="marca__texto"><span>Amigo</span><span>Animal</span></span>
      </span>
      <a class="rodape__slogan" href={agendamentoLink} target="_blank" rel="noopener noreferrer">
        {site.slogan}
        <Icone nome="setaDiagonal" />
      </a>
    </div>

    <div class="rodape__grade">
      <div>
        <h2 class="rodape__titulo">Vamos conversar?</h2>
        <p class="rodape__nota">Fale com a equipe para agendar um serviço ou consultar os produtos do pet shop.</p>
        <div class="redes">
          <a href={agendamentoLink} rel="noopener noreferrer" target="_blank">WhatsApp</a>
          <a href={site.instagram} rel="noopener noreferrer" target="_blank">Instagram</a>
        </div>
      </div>

      <div>
        <h2 class="rodape__titulo">Contato</h2>
        <div class="contatos">
          <p>
            <b>Estamos aqui:</b>{' '}
            <a href={site.mapaLink} target="_blank" rel="noopener noreferrer">{endereco}</a>
          </p>
          <p><b>Atendimento:</b> <a href={agendamentoLink} target="_blank" rel="noopener noreferrer">{site.horario}</a></p>
        </div>
        <a class="rodape__telefone" href={site.telefoneLink}>
          <Icone nome="telefone" />
          {site.telefone}
        </a>
      </div>

      <div>
        <h2 class="rodape__titulo">Links úteis</h2>
        <nav class="rodape__links" aria-label="Links do rodapé">
          {servicos.map((servico) => (
            <a href={`/#${servico.id}`}>{servico.titulo}</a>
          ))}
        </nav>
      </div>
    </div>

    <div class="rodape__base">
      <p>© {ano} {site.nomeCompleto}. Todos os direitos reservados.</p>
      <a href={site.mapaLink} target="_blank" rel="noopener noreferrer">Porto Alegre, RS</a>
    </div>
  </div>

  <a class="subir" href="/#topo" data-subir aria-label="Voltar ao topo">
    <Icone nome="setaCima" />
  </a>
</footer>
