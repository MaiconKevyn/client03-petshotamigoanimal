---
import AvaliacaoPetlove from './AvaliacaoPetlove.astro';
import Icone from './Icone.astro';
import MedalhaPet from './MedalhaPet.astro';
import { agendamentoLink } from '../data/site';
---

<section class="hero" id="topo">
  <div class="hero__visual">
    <img
      class="hero__animal"
      src="/assets/img/hero-cao-natural.webp"
      alt="Cão de porte médio olhando para cima"
      width="1536"
      height="1024"
      fetchpriority="high"
      decoding="async"
    />
    <MedalhaPet />
  </div>

  <div class="container hero__grade">
    <div class="hero__conteudo">
      <p class="hero__local"><Icone nome="local" /> Porto Alegre · Rua dos Maias, 1970</p>
      <h1 class="hero__titulo">Seu pet,<br />em boas mãos.</h1>
      <p class="hero__texto">
        Veterinário, banho e tosa e pet shop.<br />
        Cuidado de perto, em cada fase da vida.
      </p>
      <div class="hero__acoes">
        <a
          class="botao botao--creme"
          href={agendamentoLink}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Agendar pelo WhatsApp com a equipe do Amigo Animal. Abre em uma nova aba."
        >
          <Icone nome="whatsapp" />
          Agendar pelo WhatsApp
        </a>
        <a class="hero__servicos" href="#servicos">Ver serviços <Icone nome="seta" /></a>
      </div>
    </div>
  </div>
  <div class="hero__confianca">
    <AvaliacaoPetlove />
  </div>
</section>
