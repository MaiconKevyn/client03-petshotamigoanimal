---
import AvaliacaoPetlove from './AvaliacaoPetlove.astro';
import Icone from './Icone.astro';
import { site } from '../data/site';

const mensagemHero = encodeURIComponent(
  'Olá! Vim pelo site do Amigo Animal e gostaria de falar com a equipe sobre o atendimento do meu pet.',
);
---

<section class="hero" id="topo">
  <img
    class="hero__animal"
    src="/assets/img/hero-cao-natural.webp"
    alt="Cão de porte médio olhando para cima"
    width="1536"
    height="1024"
    fetchpriority="high"
    decoding="async"
  />
  <p class="hero__fantasma" aria-hidden="true">amigo<br />animal</p>

  <div class="container hero__grade">
    <div>
      <h1 class="hero__titulo">Onde o bem-estar<br />do seu pet<br />vem primeiro</h1>
      <p class="hero__texto">
        Na nossa clínica e pet shop, cada animal recebe cuidado atencioso e de alta qualidade
        em todas as fases da vida, do primeiro filhote ao companheiro de sempre.
      </p>
      <a
        class="hero__cta-mobile botao botao--magenta"
        href={`${site.whatsapp}?text=${mensagemHero}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Falar com a equipe do Amigo Animal pelo WhatsApp. Abre em uma nova aba."
      >
        <Icone nome="whatsapp" />
        Falar no WhatsApp
      </a>
    </div>

    <AvaliacaoPetlove />
  </div>
</section>
