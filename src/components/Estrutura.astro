---
import Icone from './Icone.astro';

const cartoes = [
  {
    marca: 'um',
    chip: 'Cuidado veterinário redefinido',
    titulo: 'Suporte médico durante a recuperação',
    foto: '/assets/img/internacao.webp',
    alt: 'Pug no colo de um veterinário durante o atendimento',
  },
  {
    marca: 'dois',
    chip: 'Um lar longe de casa',
    titulo: 'Ambiente acolhedor para a estadia do seu pet',
    foto: '/assets/img/hotel.webp',
    alt: 'Gato siamês descansando em ambiente aquecido',
  },
];
---

<section class="duplo" id="estrutura">
  <div class="container duplo__grade">
    {
      cartoes.map((cartao) => (
        <article class="cartao-editorial">
          <img
            class="cartao-editorial__foto"
            src={cartao.foto}
            alt={cartao.alt}
            loading="lazy"
            decoding="async"
          />
          <span class="cartao-editorial__marca" aria-hidden="true">
            {cartao.marca}
          </span>
          <div class="cartao-editorial__painel">
            <span class="chip">
              <Icone nome="pata" />
              {cartao.chip}
            </span>
            <div class="cartao-editorial__rodape">
              <h3 class="cartao-editorial__titulo">{cartao.titulo}</h3>
              <a class="link-seta" href="#contato">
                Saiba mais
                <Icone nome="seta" />
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
